# Streamlit Cloud / yerel panel sırları. Gerçek değer yazma.
# Kopyala: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# DATABASE_URL_POOLED: Supabase transaction pooler, port 6543.
# Streamlit Cloud IP'si sabit değildir; doğrudan 5432 kullanma.

DATABASE_URL_POOLED = "..."

# Yönetici Güncelle düğmesi. Fine-grained PAT, yalnız bu repo, Actions yazma.
# Yoksa düğme "güncelleme yapılandırması yok" der, ingest başlamaz.
GITHUB_DISPATCH_TOKEN = "..."

