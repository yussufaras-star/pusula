{
  "name": "Pusula",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "web/src/pages/Live.tsx"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r requirements-test.txt uvicorn && npm --prefix web ci",
  "postAttachCommand": {
    "api": "python -m uvicorn vercel_app:app --port 8000",
    "web": "npm --prefix web run dev -- --host"
  },
  "portsAttributes": {
    "5173": { "label": "Pusula", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [5173, 8000]
}
