# Pusula ortam değişkenleri. Gerçek değerleri .env dosyasına yaz; .env git'e girmez.

# Postgres (Supabase) bağlantı dizesi
DATABASE_URL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Zoho (CRM + Cliq) OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Veri merkezine göre değişir; örn. https://accounts.zoho.com ve https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
# Cliq bot incoming webhook (zapikey URL). Gölge teslimat adresi.
CLIQ_WEBHOOK_URL=
PUSULA_SHADOW_EMAIL=

# Vercel dashboard authentication and scheduled KPI nudges.
# PUSULA_PASSWORDS_JSON is a JSON object keyed by login email; store real
# passwords only in Vercel Environment Variables, never in this file.
PUSULA_PASSWORDS_JSON=
PUSULA_SESSION_SECRET=
CRON_SECRET=

# send_nudges ekstra alıcılar (rep_id, virgülle). sales dışındakiler.
# Örn. Burcu Özkan, Nihat Kemer:
# PUSULA_EXTRA_RECIPIENTS=6847331000000653001,6847331000000615001
PUSULA_EXTRA_RECIPIENTS=

# Haftalık yönetici raporu alıcıları (Cliq userids/email, virgülle).
# Örn: PUSULA_REPORT_RECIPIENTS=yonetici@firma.com,6847331000000653001
# Gölge modda --apply yine PUSULA_SHADOW_EMAIL'e gider; liste intended olarak yazılır.
# Boşsa betik UYARI basar; --apply göndermez.
PUSULA_REPORT_RECIPIENTS=

# Kısa script'ler (send_nudges vb.) — pgbouncer transaction mode (6543).
# Migration / uzun oturum için DATABASE_URL (5432) kullanılır.
DATABASE_URL_POOLED=
VERIMOR_API_KEY=

# Görüşme Analizleri (scripts/conversation_analysis.py, gorusme-analizi.yml).
# Konuşma-tanıma: anahtarı olan ilk sağlayıcı kullanılır; PUSULA_STT_PROVIDER
# zorlar (openai | elevenlabs | deepgram), PUSULA_STT_MODEL modeli değiştirir.
# OPENAI_BASE_URL ile OpenAI uyumlu başka servis (ör. Groq) kullanılabilir.
PUSULA_STT_PROVIDER=
PUSULA_STT_MODEL=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
# Bu süreden kısa çağrılar analiz edilmez (sn, varsayılan 60).
PUSULA_CONV_MIN_CALL_SEC=

# WhatsApp ingest varsayılan açık; kapatmak için 0.
PUSULA_WHATSAPP_INGEST=

# Finans modülü: yalnız yönetici görür. Tanımlıysa yalnız bu yöneticiler
# (virgüllü e-posta listesi). Boşsa tüm yöneticiler.
PUSULA_FINANCE_EMAILS=

# Finans banka bağlantıları. Değerler yalnız Vercel env ve GitHub Actions
# secrets'ta tutulur; koda ve veritabanına yazılmaz.
# Mercury: read-only API token
MERCURY_API_TOKEN=
# Wise: personal API token (read-only)
WISE_API_TOKEN=
# Stripe: restricted key (Balance + Balance transactions okuma)
STRIPE_RESTRICTED_KEY=
# İsteğe bağlı: bir şirketin ayrı token'ı varsa şirkete özel ad önceliklidir.
# <KEY> = fin_accounts.credential_key (ör. GMBH): MERCURY_TOKEN_<KEY>,
# WISE_TOKEN_<KEY>, STRIPE_KEY_<KEY>.
# Kuveyt Türk (Rexven TR): token sunucusu, API adresi, uygulama kimliği/şifresi,
# istek imzası için RSA özel anahtar (PEM; tek satırda 
 ile de olur).
KUVEYT_TURK_IDENTITY_URL=
KUVEYT_TURK_GATEWAY_URL=
KUVEYT_TURK_CLIENT_ID=
KUVEYT_TURK_CLIENT_SECRET=
KUVEYT_TURK_PRIVATE_KEY=
# Garanti BBVA (açık bankacılık; erişim onayına bağlı tek hesap)
GARANTI_API_URL=
GARANTI_CLIENT_ID=
GARANTI_CLIENT_SECRET=
GARANTI_CALLBACK_URL=
GARANTI_CONSENT_ID=
GARANTI_UNIT_NUMBER=
GARANTI_ACCOUNT_NUMBER=
GARANTI_IBAN=
# Revolut Business: OAuth client + PKCS8 PEM özel anahtar + refresh token + redirect alan adı
REVOLUT_CLIENT_ID_GMBH=
REVOLUT_PRIVATE_KEY_GMBH=
REVOLUT_REFRESH_TOKEN_GMBH=
REVOLUT_ISS_GMBH=
