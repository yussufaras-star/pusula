# Pusula ortam değişkenleri. Gerçek değerleri .env dosyasına yaz; .env git'e girmez.

# Postgres (Supabase) bağlantı dizesi
DATABASE_URL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Zoho (CRM + Cliq) OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Veri merkezine göre değişir; örn. https://accounts.zoho.com ve https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=

# Cliq bot incoming webhook (zapikey URL). Gölge teslimat adresi.
CLIQ_WEBHOOK_URL=
PUSULA_SHADOW_EMAIL=

# send_nudges ekstra alıcılar (rep_id, virgülle). sales dışındakiler.
# Örn. Burcu Özkan, Nihat Kemer:
# PUSULA_EXTRA_RECIPIENTS=6847331000000653001,6847331000000615001
PUSULA_EXTRA_RECIPIENTS=

# Kısa script'ler (send_nudges vb.) — pgbouncer transaction mode (6543).
# Migration / uzun oturum için DATABASE_URL (5432) kullanılır.
DATABASE_URL_POOLED=
