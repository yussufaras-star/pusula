# Pusula ortam değişkenleri. Gerçek değerleri .env dosyasına yaz; .env git'e girmez.

# Postgres (Supabase) bağlantı dizesi
DATABASE_URL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Zoho (CRM + Cliq) OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Veri merkezine göre değişir; örn. https://accounts.zoho.com ve https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
# Cliq bot incoming webhook (zapikey URL). Gölge teslimat adresi.
CLIQ_WEBHOOK_URL=
PUSULA_SHADOW_EMAIL=

# Vercel dashboard authentication and scheduled KPI nudges.
# PUSULA_PASSWORDS_JSON is a JSON object keyed by login email; store real
# passwords only in Vercel Environment Variables, never in this file.
PUSULA_PASSWORDS_JSON=
PUSULA_SESSION_SECRET=
CRON_SECRET=

# send_nudges ekstra alıcılar (rep_id, virgülle). sales dışındakiler.
# Örn. Burcu Özkan, Nihat Kemer:
# PUSULA_EXTRA_RECIPIENTS=6847331000000653001,6847331000000615001
PUSULA_EXTRA_RECIPIENTS=

# Haftalık yönetici raporu alıcıları (Cliq userids/email, virgülle).
# Örn: PUSULA_REPORT_RECIPIENTS=yonetici@firma.com,6847331000000653001
# Gölge modda --apply yine PUSULA_SHADOW_EMAIL'e gider; liste intended olarak yazılır.
# Boşsa betik UYARI basar; --apply göndermez.
PUSULA_REPORT_RECIPIENTS=

# Kısa script'ler (send_nudges vb.) — pgbouncer transaction mode (6543).
# Migration / uzun oturum için DATABASE_URL (5432) kullanılır.
DATABASE_URL_POOLED=
VERIMOR_API_KEY=

# WhatsApp ingest (KVKK: ekibe yazılı aydınlatma sonrası 1 yapın).
PUSULA_WHATSAPP_INGEST=
